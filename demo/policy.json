{
  "targets": {
    "demo-wp": {
      "kind": "mcp_http",
      "url": "http://wordpress/wp-json/tokening-demo/mcp",
      "credential": {
        "type": "basic",
        "ref": "vault:demo-wp"
      }
    }
  },
  "templates": {
    "wp.edit-post-text": {
      "target": "demo-wp",
      "tool": "wp_update_post",
      "args": {
        "id": {
          "bind": "required"
        },
        "title": {
          "type": "string",
          "max_len": 200
        },
        "content": {
          "type": "string",
          "max_bytes": 32768
        }
      },
      "additional_args": "refuse",
      "max_uses": 3,
      "max_ttl": "30m"
    },
    "wp.read-post": {
      "target": "demo-wp",
      "tool": "wp_get_post",
      "args": {
        "id": {
          "bind": "required"
        }
      },
      "max_uses": 20,
      "max_ttl": "1h"
    }
  }
}
